{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 60,
      "includeFiles": "{data/knowledge/*.json,data/ask/*.json,public/data/sources/sources.json}"
    }
  }
}
